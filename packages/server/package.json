{
  "name": "@media-app/server",
  "version": "0.1.303",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.11",
    "@media-app/shared": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "js-yaml": "^4.3.2",
    "mime-types": "^2.1.35",
    "p-queue": "^8.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
